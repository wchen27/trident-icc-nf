process {
    container     = 'wchen27/trident-cpu:0.3.1-tiles.3'
    cpus          = 2
    memory        = { 8.GB * task.attempt }
    time          = { 2.h * task.attempt }
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries    = 1

    withName: SUMMARY {
        cpus          = 1
        memory        = 4.GB
        errorStrategy = 'terminate'
    }
}

docker.enabled = true
